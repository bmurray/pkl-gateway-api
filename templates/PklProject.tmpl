amends "pkl:Project"

package {
  name = "gateway-api"
  baseUri = "package://github.com/bmurray/pkl-gateway-api/releases/download/{{.ReleaseTag}}/gateway-api"
  version = "{{.Version}}"
  packageZipUrl = "https://github.com/bmurray/pkl-gateway-api/releases/download/{{.ReleaseTag}}/\(name)@\(version).zip"
  sourceCode = "https://github.com/bmurray/pkl-gateway-api"
  license = "Apache-2.0"
  description = """
    Templates for configuring [Kubernetes Gateway API](https://gateway-api.sigs.k8s.io),
    the next-generation API for routing in Kubernetes.
    """
}

dependencies {
  ["k8s"] {
    uri = "package://pkg.pkl-lang.org/pkl-k8s/k8s@{{.K8sVersion}}"
  }
}
